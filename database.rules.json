{
  "rules": {
    "rooms": {
      "$room_id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "quickMatch": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || data.child('role').val() === 'admin' || data.val() === 'admin' || data.val() === true)",
        ".write": "false"
      }
    },
    "financials": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "false"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "wallet": {
          "cashBalance": {
            ".write": "false"
          },
          "demoBalance": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "transactions": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "false"
        }
      }
    }
  }
}
